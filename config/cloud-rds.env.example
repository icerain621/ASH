# ASH 云 RDS 环境变量模板（SQL revision 20）
#
# 用法：
#   cp config/cloud-rds.env.example config/cloud-rds.env
#   # 编辑 config/cloud-rds.env，填入真实 host / 密码（勿提交 git）
#   set -a && source config/cloud-rds.env && set +a
#   bash scripts/source-cloud-rds-env.sh
#   make cloud-acceptance          # H-01~H-02 云验收 + 证据
#   make mvp-signoff               # MVP 签字（含云验收若已 source）
#
# 清单：doc/checklists/h01-h03-cloud-signoff.md
# 说明：doc/checklists/postgres-production-config.md

# -----------------------------------------------------------------------------
# 1. 云 RDS 连接（必填）
# -----------------------------------------------------------------------------

# 区域示例：
#   AWS RDS:   ash.xxxxxx.ap-northeast-1.rds.amazonaws.com
#   阿里云 RDS: pgm-xxxxx.pg.rds.aliyuncs.com
#   自建云:     db.example.com

# 迁移 / Doctor / DDL（owner 角色 ash，可执行 migrate schema）
ASH_DATABASE_URL=postgres://ash:CHANGE_ME_MIGRATOR_PW@CHANGE_ME_RDS_HOST:5432/ash?sslmode=require

# Worker 运行时（应用角色 ash_app，NOBYPASSRLS；H-02/H-03 必填）
ASH_DATABASE_APP_URL=postgres://ash_app:CHANGE_ME_APP_PW@CHANGE_ME_RDS_HOST:5432/ash?sslmode=require

# 若使用 verify-full，追加 CA（按云厂商文档）：
# ASH_DATABASE_URL=postgres://ash:...@host:5432/ash?sslmode=verify-full&sslrootcert=/path/to/rds-ca.pem
# ASH_DATABASE_APP_URL=postgres://ash_app:...@host:5432/ash?sslmode=verify-full&sslrootcert=/path/to/rds-ca.pem

# -----------------------------------------------------------------------------
# 2. Schema / 迁移 / RLS（H-01 / H-02）
# -----------------------------------------------------------------------------

# SQL-only 建表，关闭 GORM AutoMigrate
ASH_SCHEMA_MODE=sql

# SQLite 源数据路径（migrate plan/copy/verify）
ASH_DATA_DIR=.ash
ASH_SQLITE_PATH=.ash/ash.db

# migrate 前备份：make data-backup

# 启用迁移 E2E 断言（Doctor M3-04 非 skip）
ASH_MIGRATE_E2E=1

# RLS 安装与强制（修订 000013–000020，策略 ≥41）
ASH_POSTGRES_RLS=1
ASH_POSTGRES_RLS_FORCE=1

# -----------------------------------------------------------------------------
# 3. Worker 生产运行时（H-03）
# -----------------------------------------------------------------------------

# Worker 监听（按需）
ASH_HTTP_ADDR=:8080

# 生产务必改为 jwt + 强密钥
ASH_AUTH_MODE=jwt
ASH_JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
ASH_SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY

# 可选：PgBouncer 时 Worker 仅用 ASH_DATABASE_APP_URL（session 模式 pooler）
# 迁移/Doctor 仍用 ASH_DATABASE_URL 直连 RDS

# -----------------------------------------------------------------------------
# 4. Live 烟测（H-04~H-09，云验收 §7 / H-03 签字后）
# -----------------------------------------------------------------------------

# Worker 基址（live-smoke / release-sampling-smoke）
# ASH_WORKER_URL=https://worker.example.com

# CI fixture 模式（无真实 GitHub token 时 H-04/05/07）
# ASH_CI_FIXTURE=1

# ExecGo live（H-06，需已部署 ExecGo）
# ASH_EXECGO_E2E=1
# ASH_CODEX_BIN=codex

# 默认空间与鉴权（按需）
# ASH_SPACE_ID=prod
# ASH_AUTH_HEADER=Bearer CHANGE_ME_TOKEN

# -----------------------------------------------------------------------------
# 5. 可观测（可选，生产推荐）
# -----------------------------------------------------------------------------

# ASH_METRICS_EVENT_REPLAY=1
# ASH_ALERTS_EVAL_INTERVAL=5m
# ASH_MEMORY_TTL_SWEEP_INTERVAL=24h
# ASH_MEMORY_TTL_L1_DAYS=90
# ASH_MEMORY_TTL_L2_DAYS=365
# ASH_OTEL_ENABLED=1
# ASH_OTEL_ENDPOINT=otel-collector:4317

# -----------------------------------------------------------------------------
# 6. 验收门禁快捷命令（source 本文件后）
# -----------------------------------------------------------------------------
#
# bash scripts/postgres-smoke.sh          # 连通性
# make cloud-acceptance                   # H-01~H-02 全链路 + doc/evidence/
# go run ./cmd/worker                     # H-03 Worker
# curl -s http://127.0.0.1:8080/readyz    # dialect=postgres, sqlMigrationVersion=20
# ASH_WORKER_URL=http://127.0.0.1:8080 ASH_CI_FIXTURE=1 make live-smoke
