# ASH MVP v0.1 发布签字配置
#
# 用法：
#   cp config/signoff.env.example config/signoff.env
#   # 评审会后填写四人姓名与日期（勿提交真实姓名到公开仓库时可仅用内网 fork）
#   bash scripts/source-signoff-env.sh
#   make signoff-apply          # 回填 §11 / 范围冻结 / 证据摘要
#   make signoff-gate           # 验收签字是否齐全
#
# 清单：doc/checklists/mvp-signoff-roster.md

# -----------------------------------------------------------------------------
# §11 四人签字（必填，发布前）
# -----------------------------------------------------------------------------

ASH_SIGNOFF_PRODUCT_NAME=
ASH_SIGNOFF_PRODUCT_DATE=

ASH_SIGNOFF_TECH_NAME=
ASH_SIGNOFF_TECH_DATE=

ASH_SIGNOFF_QA_NAME=
ASH_SIGNOFF_QA_DATE=

ASH_SIGNOFF_RELEASE_NAME=
ASH_SIGNOFF_RELEASE_DATE=

# -----------------------------------------------------------------------------
# 范围冻结（产品负责人确认后设为 1）
# -----------------------------------------------------------------------------

# 设为 1 后 signoff-apply 将 mvp-release-scope.md 标为「已冻结」
ASH_SCOPE_FREEZE_SIGNED=0
ASH_SCOPE_FREEZE_DATE=

# 可选：发布窗口值班（对应 release-window-runbook.md §2）
ASH_RELEASE_WINDOW_START=
ASH_RELEASE_ONCALL_TECH=
ASH_RELEASE_ONCALL_DBA=
