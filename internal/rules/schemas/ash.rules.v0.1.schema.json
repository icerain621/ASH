{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ash.rules/v0.1",
  "title": "ASH Rules DSL v0.1",
  "type": "object",
  "required": ["version", "scenario"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "ash.rules/v0.1"
    },
    "scenario": { "$ref": "#/$defs/scenario" },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["name", "scenarioVersion", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scenarioVersion": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "policyProfile": {
          "type": "string",
          "enum": ["default", "strict", "hotfix", "security"]
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Skill ids (SKILL.md name) to inject as skill: contextRefs"
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scenario sandbox floor (DX2)",
          "properties": {
            "minMode": {
              "type": "string",
              "enum": ["off", "read-only", "workspace-write", "isolated"]
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["per_step", "per_tool", "manual"]
            },
            "retain": { "type": "integer", "minimum": 0 }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/role" }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "optional": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": { "$ref": "#/$defs/artifactRef" }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallel": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "when", "check"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "check": { "$ref": "#/$defs/gateCheck" },
        "onFail": { "$ref": "#/$defs/gateOnFail" },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "gateCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "expect": { "type": "object" }
      }
    },
    "gateOnFail": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "remediation": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolChainItem" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "role", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["llm", "agent", "tool_chain", "human", "verify"]
        },
        "promptRef": { "type": "string" },
        "rag": { "$ref": "#/$defs/ragSpec" },
        "agent": { "$ref": "#/$defs/agentSpec" },
        "chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolChainItem" }
        },
        "verify": { "$ref": "#/$defs/verifySpec" },
        "gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": { "$ref": "#/$defs/stepOutputs" },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "verifySpec": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toolChainItem" }
        },
        "onFail": {
          "type": "string",
          "enum": ["fail", "improve"],
          "description": "fail blocks the run; improve also creates an improve proposal draft"
        }
      }
    },
    "ragSpec": {
      "type": "object",
      "required": ["sources", "requireCitations"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requireCitations": { "type": "boolean" },
        "onMissingCitations": {
          "type": "string",
          "enum": ["block", "human_confirm"]
        }
      }
    },
    "agentSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt": { "type": "string" }
      }
    },
    "toolChainItem": {
      "type": "object",
      "required": ["tool"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "args": { "type": "object" },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "retry": { "$ref": "#/$defs/retry" },
        "policy": { "type": "string" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "backoffMs": { "type": "integer", "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string" }
      }
    },
    "stepOutputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "memoryCandidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryCandidate" }
        }
      }
    },
    "memoryCandidate": {
      "type": "object",
      "required": ["layer"],
      "additionalProperties": false,
      "properties": {
        "layer": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "evidenceFrom": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hook": {
      "type": "object",
      "required": ["id", "on", "policy", "rules"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "on": {
          "type": "string",
          "enum": [
            "tool.called",
            "tool.result",
            "run.before_finish",
            "run.started",
            "step.started",
            "step.finished",
            "policy.denied",
            "memory.candidate_created"
          ]
        },
        "policy": {
          "type": "string",
          "enum": ["enforce", "observe"]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hookRule" }
        }
      }
    },
    "hookRule": {
      "type": "object",
      "required": ["match", "action"],
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "object",
          "minProperties": 1
        },
        "action": {
          "type": "object",
          "required": ["deny"],
          "additionalProperties": false,
          "properties": {
            "deny": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  }
}
