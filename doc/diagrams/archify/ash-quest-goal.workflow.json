  "cards": [
    {
      "dot": "emerald",
      "title": "Scenario DSL",
      "items": [
        "steps 对齐 internal/goal FromGoal",
        "产物：GoalPlan → Run 绑定"
      ]
    },
    {
      "dot": "rose",
      "title": "门禁",
      "items": [
        "draft 经 Approve 进入 started",
        "Reject 终止；autoApprove 可跳过"
      ]
