      "to": "review",
      "variant": "emphasis"
    },
    {
      "id": "review-ship",
      "from": "review",
      "to": "ship",
      "variant": "emphasis"
    },
    {
      "id": "code-deny",
      "from": "implement",
      "to": "deny",
      "label": "danger tool",
      "variant": "security",
      "role": "error"
