{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ASH Quest 场景",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "ash-quest-goal.html",
    "views": [
      {
        "id": "happy-path",
        "label": "主路径",
        "focus": [
          "clarify",
          "design",
          "implement",
          "verify",
          "review",
          "ship"
        ],
        "note": "from-goal → 路由 → draft → 批准 → Run。"
      },
      {
        "id": "gates",
        "label": "审批与拒绝",
        "focus": [
          "implement",
          "deny",
          "approval"
        ],
        "note": "draft 可 Approve 或 Reject。"
      },
      {
        "id": "verify-retry",
        "label": "自动批准",
        "focus": [
          "verify",
          "implement"
        ],
        "note": "autoApprove 跳过人审。"
      }
    ]
  },
  "lanes": [
    {
      "id": "plan",
      "label": "Goal 入口"
    },
    {
      "id": "build",
      "label": "Plan 编排"
    },
    {
      "id": "policy",
      "label": "门禁与审批",
      "variant": "exception"
    },
    {
      "id": "ship",
      "label": "Run 启动"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "澄清 + 设计",
      "fromCol": 0,
      "toCol": 1
