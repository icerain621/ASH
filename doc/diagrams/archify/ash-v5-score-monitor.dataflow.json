{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "ASH v5 评分与交互监控数据流",
    "locale": "zh-CN",
    "output": "ash-v5-score-monitor.html",
    "viewBox": [1080, 540],
    "quality_profile": "showcase",
    "views": [
      { "id": "ingest", "label": "事件摄入", "focus": ["runs", "memory", "append"], "note": "Run 与 Memory 事件进入统一写入。" },
      { "id": "pipeline", "label": "监控与评分", "focus": ["store", "monitor", "scoring"], "note": "投影时间线后写入量纲评分。" },
      { "id": "consume", "label": "消费端", "focus": ["queue", "viz", "kpi"], "note": "队列、Workbench 与 KPI 共用评分事实。" }
    ]
  },
  "stages": [
    { "label": "事件源" },
    { "label": "写入" },
    { "label": "存储" },
    { "label": "评分管线" },
    { "label": "消费" }
  ],
  "nodes": [
    { "id": "runs", "type": "backend", "label": "Run Engine", "sublabel": "run events", "stage": 0, "row": 0, "tag": "Agent" },
    { "id": "memory", "type": "database", "label": "Memory Core", "sublabel": "candidate", "stage": 0, "row": 2, "tag": "Memory" },
    { "id": "append", "type": "backend", "label": "events.Append", "sublabel": "visibility", "stage": 1, "row": 1, "tag": "事务" },
    { "id": "store", "type": "database", "label": "Event Store", "sublabel": "append-only", "stage": 2, "row": 1, "tag": "真相源" },
    { "id": "monitor", "type": "backend", "label": "Interaction", "sublabel": "timeline", "stage": 3, "row": 0, "tag": "Monitor" },
    { "id": "scoring", "type": "backend", "label": "Scoring", "sublabel": "rubric", "stage": 3, "row": 2, "tag": "score" },
    { "id": "queue", "type": "cloud", "label": "Review Queue", "sublabel": "evolve", "stage": 4, "row": 0 },
    { "id": "viz", "type": "frontend", "label": "Workbench", "sublabel": "replay", "stage": 4, "row": 1 },
    { "id": "kpi", "type": "cloud", "label": "Derive KPI", "sublabel": "metrics", "stage": 4, "row": 2 }
  ],
  "flows": [
    { "id": "runs-append", "from": "runs", "to": "append", "label": "run events", "classification": "envelope", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "mem-append", "from": "memory", "to": "append", "label": "memory events", "classification": "envelope", "variant": "default", "route": "vertical-channel" },
    { "id": "append-store", "from": "append", "to": "store", "label": "seq++ 落盘", "classification": "append-only", "variant": "emphasis", "route": "straight" },
    { "id": "store-monitor", "from": "store", "to": "monitor", "label": "fold surface", "classification": "projection", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "store-scoring", "from": "store", "to": "scoring", "label": "score inputs", "classification": "rubric", "variant": "default", "route": "vertical-channel" },
    { "id": "monitor-queue", "from": "monitor", "to": "queue", "label": "replay feed", "classification": "human gate", "variant": "security", "route": "straight" },
    { "id": "scoring-viz", "from": "scoring", "to": "viz", "label": "radar", "classification": "read model", "variant": "emphasis", "route": "vertical-channel", "labelDy": -28 },
    { "id": "scoring-kpi", "from": "scoring", "to": "kpi", "label": "derive", "classification": "metrics", "variant": "dashed", "route": "straight", "labelDy": 28 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "摄入",
      "items": [
        "Run / Memory 事件统一 Append",
        "visibility 区分 model / ui / audit"
      ]
    },
    {
      "dot": "emerald",
      "title": "评分事实",
      "items": [
        "量纲写入 score_events，禁止 UI 私算",
        "Interaction 投影供回放与实时质量"
      ]
    },
    {
      "dot": "rose",
      "title": "消费",
      "items": [
        "监控投影供给评审队列",
        "Workbench 与 KPI 消费评分派生层"
      ]
    }
  ]
}
