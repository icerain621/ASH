{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ASH hotfix 场景",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "ash-hotfix.html",
    "views": [
      {
        "id": "happy-path",
        "label": "热修复主路径",
        "focus": [
          "clarify",
          "design",
          "implement",
          "verify",
          "review",
          "ship"
        ],
        "note": "SRE 定界 → 最小修复 → 验证 → 人审 → 发布。"
      },
      {
        "id": "gates",
        "label": "门禁与危险工具",
        "focus": [
          "implement",
          "clean",
          "deny",
          "approval"
        ],
        "note": "git.status 工作区门禁；shell.exec danger 默认 deny。"
      },
      {
        "id": "verify-retry",
        "label": "验证与改进",
        "focus": [
          "verify",
          "implement"
        ],
        "note": "qa.verify 失败可回环；hotfix 侧重定向验证。"
      }
    ]
  },
  "lanes": [
    {
      "id": "plan",
      "label": "SRE 定界"
    },
    {
      "id": "build",
      "label": "修复与验证"
    },
    {
      "id": "policy",
      "label": "门禁与审批",
      "variant": "exception"
    },
    {
      "id": "ship",
      "label": "发布窗"
    }
  ],
  "phases": [
