  "cards": [
    {
      "dot": "emerald",
      "title": "Scenario DSL",
      "items": [
        "steps 对齐 scenarios/hotfix.yaml",
        "产物：diff / test_report / release_notes / rollback_plan"
      ]
    },
    {
      "dot": "rose",
      "title": "门禁",
      "items": [
        "sandbox.minMode=isolated；sre.approve_ship 人审",
