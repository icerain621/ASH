{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "ASH Memory 候选治理流",
    "locale": "zh-CN",
    "output": "ash-memory-lifecycle.html",
    "viewBox": [1080, 520],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "create-path",
        "label": "候选写入",
        "focus": ["run", "create", "records"],
        "note": "Run/场景输出 CreateCandidate → status=candidate。"
      },
      {
        "id": "review-path",
        "label": "评审决策",
        "focus": ["records", "review", "approved"],
        "note": "Review 将候选转为 approved / rejected / deprecated。"
      },
      {
        "id": "retrieve-path",
        "label": "检索与命中",
        "focus": ["approved", "query", "rag", "hit"],
        "note": "Query 检索 approved；hit_used 审计回写 run_events。"
      }
    ]
  },
  "stages": [
    { "label": "来源" },
    { "label": "候选" },
    { "label": "评审" },
    { "label": "检索" },
    { "label": "消费" }
  ],
  "nodes": [
    { "id": "run", "type": "backend", "label": "Run / Scenario", "sublabel": "memoryCandidates", "stage": 0, "row": 1, "tag": "L1/L2" },
    { "id": "create", "type": "backend", "label": "CreateCandidate", "sublabel": "internal/memory", "stage": 1, "row": 1, "tag": "status=candidate" },
    { "id": "records", "type": "database", "label": "memory_records", "sublabel": "+ evidence", "stage": 2, "row": 1, "tag": "GORM" },
    { "id": "review", "type": "security", "label": "Review", "sublabel": "approve / reject", "stage": 2, "row": 0, "tag": "governance" },
    { "id": "approved", "type": "database", "label": "approved 记忆", "sublabel": "confidence ≥ 0.2", "stage": 3, "row": 1, "tag": "queryable" },
    { "id": "query", "type": "backend", "label": "Query", "sublabel": "FTS / filters", "stage": 3, "row": 0, "tag": "memory.query" },
    { "id": "rag", "type": "backend", "label": "RAG Retriever", "sublabel": "memory:L1", "stage": 4, "row": 0, "tag": "citation" },
    { "id": "hit", "type": "messagebus", "label": "hit_used", "sublabel": "run_events 审计", "stage": 4, "row": 2, "tag": "memory.hit_used" }
  ],
  "flows": [
    { "id": "run-create", "from": "run", "to": "create", "label": "候选请求", "classification": "L1/L2", "variant": "emphasis", "route": "straight" },
    { "id": "create-records", "from": "create", "to": "records", "label": "persist + evidence", "classification": "append", "variant": "emphasis", "route": "straight" },
    { "id": "records-review", "from": "records", "to": "review", "label": "review_requested", "classification": "governance", "variant": "security", "route": "vertical-channel" },
    { "id": "review-approved", "from": "review", "to": "approved", "label": "approved", "classification": "decision", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "approved-query", "from": "approved", "to": "query", "label": "可检索集", "classification": "confidence", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "query-rag", "from": "query", "to": "rag", "label": "hits + citation", "classification": "retrieval", "variant": "emphasis", "route": "straight" },
    { "id": "rag-hit", "from": "rag", "to": "hit", "label": "hit_used 审计", "classification": "audit", "variant": "dashed", "route": "vertical-channel" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "候选 → 评审",
      "items": [
        "CreateCandidate 写入 memory_records（status=candidate）",
        "Review 决策：approved / rejected / deprecated"
      ]
    },
    {
      "dot": "cyan",
      "title": "检索消费",
      "items": [
        "Query 仅返回 confidence ≥ MinQueryableConfidence",
        "RAG 引用后 emit memory.hit_used 到 run_events"
      ]
    },
    {
      "dot": "rose",
      "title": "治理",
      "items": [
        "创建时 previewGovernance 去重提示",
        "事件：candidate_created / reviewed / query / hit_used"
      ]
    }
  ]
}
