{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "ASH run_events 数据流",
    "locale": "zh-CN",
    "output": "ash-run-events.html",
    "viewBox": [1080, 520],
    "quality_profile": "showcase",
    "views": [
      { "id": "append-path", "label": "写入主路径", "focus": ["runs", "append", "store"], "note": "Run Engine 经 events.Append 顺序写入 run_events。" },
      { "id": "live-stream", "label": "SSE 续传", "focus": ["store", "sse", "console"], "note": "控制台按 seq 续传 Timeline，不阻塞编排。" },
      { "id": "replay-derive", "label": "回放与派生", "focus": ["store", "replay", "metrics"], "note": "replay/doctor 读事件真相；Prometheus 为派生视图。" }
    ]
  },
  "stages": [
    { "label": "生产者" },
    { "label": "写入" },
    { "label": "存储" },
    { "label": "分发" },
    { "label": "消费者" }
  ],
  "nodes": [
    { "id": "runs", "type": "backend", "label": "Run Engine", "sublabel": "internal/runs", "stage": 0, "row": 1, "tag": "run.*" },
    { "id": "toolbus", "type": "backend", "label": "ToolBus", "sublabel": "tool.called", "stage": 0, "row": 2, "tag": "tool.*" },
    { "id": "append", "type": "backend", "label": "events.Append", "sublabel": "seq + payload", "stage": 1, "row": 1, "tag": "事务" },
    { "id": "store", "type": "database", "label": "run_events", "sublabel": "SQLite / Postgres", "stage": 2, "row": 1, "tag": "append-only" },
    { "id": "sse", "type": "messagebus", "label": "SSE", "sublabel": "GET /runs/:id/events", "stage": 3, "row": 0, "tag": "Last-Event-ID" },
    { "id": "replay", "type": "backend", "label": "Replay / Doctor", "sublabel": "TR0-03", "stage": 3, "row": 2, "tag": "真相源" },
    { "id": "console", "type": "frontend", "label": "Console Timeline", "sublabel": "/ui/ runs", "stage": 4, "row": 0, "tag": "live" },
    { "id": "metrics", "type": "cloud", "label": "Prometheus", "sublabel": "/metrics 派生", "stage": 4, "row": 2, "tag": "非真相" }
  ],
  "flows": [
    { "id": "runs-append", "from": "runs", "to": "append", "label": "run/step 事件", "classification": "envelope", "variant": "emphasis", "route": "straight", "labelDy": -28 },
    { "id": "tool-append", "from": "toolbus", "to": "append", "label": "tool.* 事件", "classification": "payload schema", "variant": "default", "route": "vertical-channel" },
    { "id": "append-store", "from": "append", "to": "store", "label": "seq++ 落盘", "classification": "append-only", "variant": "emphasis", "route": "straight" },
    { "id": "store-sse", "from": "store", "to": "sse", "label": "按 seq 推送", "classification": "resume", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "sse-console", "from": "sse", "to": "console", "label": "text/event-stream", "classification": "live", "variant": "emphasis", "route": "straight" },
    { "id": "store-replay", "from": "store", "to": "replay", "label": "全量重放", "classification": "audited", "variant": "dashed", "route": "vertical-channel" },
    { "id": "store-metrics", "from": "store", "to": "metrics", "label": "derive 指标", "classification": "derived", "variant": "dashed", "route": "bottom-channel", "labelDy": 28 }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "真相来源",
      "items": [
        "run_events 顺序 seq 为回放与审计真相",
        "events.Append 校验 payload schema 后事务写入"
      ]
    },
    {
      "dot": "cyan",
      "title": "SSE 续传",
      "items": [
        "GET /api/v1/runs/:runId/events 按 Last-Event-ID 续传",
        "Timeline 消费不阻塞 Run 主循环"
      ]
    },
    {
      "dot": "rose",
      "title": "派生视图",
      "items": [
        "Prometheus /metrics 由事件离线派生",
        "Doctor TR0-03 以事件重放验证一致性"
      ]
    }
  ]
}
